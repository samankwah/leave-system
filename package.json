{
  "name": "leave-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "node scripts/reset-db.mjs",
    "test:e2e": "npm run build:e2e && playwright test flows",
    "screenshots": "npm run build:e2e && playwright test screenshots",
    "dev:local": "node scripts/dev-local.mjs",
    "build:e2e": "node -e \"process.env.NEXT_DIST_DIR='.next-build';require('child_process').execFileSync(process.execPath,['node_modules/next/dist/bin/next','build'],{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@vercel/functions": "^3.10.4",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.14.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
